<UserControl x:Class="MasterConsole.Controls.PlaceholderPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- 占位框：以后接入影像解码控件 / URDF 三维视图时，直接替换 Content，不改外围布局。 -->
    <Border Background="#0F172A" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <Rectangle Margin="10" RadiusX="6" RadiusY="6"
                       Stroke="#334155" StrokeThickness="1.2" StrokeDashArray="4 4"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding Title, ElementName=Root}"
                           Foreground="#E2E8F0" FontSize="15" FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Hint, ElementName=Root}"
                           Foreground="#64748B" FontSize="11.5" Margin="0,6,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Background="#1E293B" CornerRadius="3" Padding="7,2"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0">
                <TextBlock Text="预留" Foreground="#94A3B8" FontSize="10.5"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
