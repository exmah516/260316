<UserControl x:Class="MasterConsole.Controls.RobotViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
             x:Name="Root">
    <Border Background="#0F172A" CornerRadius="6" ClipToBounds="True">
        <Grid>
            <wfi:WindowsFormsHost x:Name="FormsHost" Margin="1" />
            <Border Panel.ZIndex="2" Background="#D90F172A" Padding="8,5" HorizontalAlignment="Left"
                    VerticalAlignment="Top" Margin="12" CornerRadius="4">
                <StackPanel>
                    <TextBlock Text="机器人 URDF 模型" Foreground="#E2E8F0"
                               FontSize="13" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="正在加载…" Foreground="#CBD5E1"
                               FontSize="11" Margin="0,3,0,0" />
                </StackPanel>
            </Border>
            <StackPanel Panel.ZIndex="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,12,12,0">
                <Button Content="发布测试数据" Click="PublishTest_Click" Padding="8,3"
                        Background="#CC1E293B" Foreground="#E2E8F0" BorderBrush="#475569" />
                <Button Content="恢复视角" Click="ResetView_Click" Margin="6,0,0,0" Padding="8,3"
                        Background="#CC1E293B" Foreground="#E2E8F0" BorderBrush="#475569" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
