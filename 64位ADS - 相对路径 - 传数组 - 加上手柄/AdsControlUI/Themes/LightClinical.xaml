<!--
  LightClinical.xaml —— 浅色临床 / 医疗 HMI 主题
  适用：血管介入机器人上位机（AdsControlUI, WPF net472）

  设计取向：
    · 纯白卡片 + 浅蓝灰底，干净、专业、长时间盯看不累眼
    · 单一强调色（医疗蓝 #0EA5E9 / #0369A1），状态语义色仅用于状态指示
    · 界面字体 Microsoft YaHei UI；数值读数用等宽字体
    · 签名元素：顶部状态条"药丸"式指示灯
  资源 key 全部在此字典内自洽，外部窗口只需引用样式 key。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 调色板 ===================== -->
    <SolidColorBrush x:Key="AppBackgroundBrush"     Color="#F1F5F9"/> <!-- slate-100 应用底 -->
    <SolidColorBrush x:Key="SurfaceBrush"           Color="#FFFFFF"/> <!-- 纯白卡片 -->
    <SolidColorBrush x:Key="SurfaceAltBrush"        Color="#F8FAFC"/> <!-- 次级面 / 表头 -->
    <SolidColorBrush x:Key="SurfaceHoverBrush"      Color="#F1F5F9"/>

    <SolidColorBrush x:Key="BorderBrush"            Color="#E2E8F0"/> <!-- slate-200 细边 -->
    <SolidColorBrush x:Key="BorderStrongBrush"      Color="#CBD5E1"/> <!-- slate-300 控件边 -->

    <SolidColorBrush x:Key="TextPrimaryBrush"       Color="#0F172A"/> <!-- slate-900 -->
    <SolidColorBrush x:Key="TextSecondaryBrush"     Color="#475569"/> <!-- slate-600 -->
    <SolidColorBrush x:Key="TextMutedBrush"         Color="#94A3B8"/> <!-- slate-400 -->

    <!-- 强调色（医疗蓝） -->
    <SolidColorBrush x:Key="AccentBrush"            Color="#0EA5E9"/> <!-- sky-500 -->
    <SolidColorBrush x:Key="AccentDeepBrush"        Color="#0369A1"/> <!-- sky-700 -->
    <SolidColorBrush x:Key="AccentSoftBrush"        Color="#E0F2FE"/> <!-- sky-100 -->

    <!-- 状态语义色 -->
    <SolidColorBrush x:Key="StatusGreenBrush"       Color="#22C55E"/>
    <SolidColorBrush x:Key="StatusGreenSoftBrush"   Color="#DCFCE7"/>
    <SolidColorBrush x:Key="StatusAmberBrush"       Color="#F59E0B"/>
    <SolidColorBrush x:Key="StatusAmberSoftBrush"   Color="#FEF3C7"/>
    <SolidColorBrush x:Key="StatusRedBrush"         Color="#EF4444"/>
    <SolidColorBrush x:Key="StatusRedSoftBrush"     Color="#FEE2E2"/>
    <SolidColorBrush x:Key="StatusOffBrush"         Color="#CBD5E1"/>

    <!-- 数据曲线专用（与 ForceRealtimeWindow 一致） -->
    <SolidColorBrush x:Key="SeriesForceBrush"       Color="#EF4444"/>
    <SolidColorBrush x:Key="SeriesTorqueBrush"      Color="#0EA5E9"/>

    <!-- ===================== 字体 ===================== -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, PingFang SC, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="DataFont">Cascadia Mono, Consolas, Cascadia Code, Courier New, monospace</FontFamily>

    <!-- ===================== 通用默认样式 ===================== -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== 文本角色 ===================== -->
    <!-- 窗口主标题 -->
    <Style x:Key="WindowTitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- 数据读数（等宽） -->
    <Style x:Key="DataValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- 次要说明文字 -->
    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
    </Style>

    <!-- 错误提示 -->
    <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource StatusRedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 字段标签 -->
    <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== GroupBox 卡片 ===================== -->
    <Style TargetType="GroupBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.06" Direction="270" Color="#0F172A"/>
                        </Border.Effect>
                        <DockPanel LastChildFill="True">
                            <!-- 表头：次级面 + 医疗蓝分隔线 + 深蓝标题 -->
                            <Border DockPanel.Dock="Top"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="14,9,14,9">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="3" Height="13" Fill="{StaticResource AccentBrush}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <ContentPresenter ContentSource="Header"
                                                      TextElement.FontWeight="SemiBold"
                                                      TextElement.FontSize="12.5"
                                                      TextElement.Foreground="{StaticResource AccentDeepBrush}"
                                                      VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Button ===================== -->
    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#E2E8F0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 主操作按钮（强调色实心） -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AccentDeepBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentDeepBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#075985"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ToggleButton（电缸/开关） ===================== -->
    <Style TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="Led" Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{StaticResource StatusOffBrush}"/>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Led" Property="Fill" Value="{StaticResource StatusGreenBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource StatusGreenSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StatusGreenBrush}"/>
                <Setter Property="Foreground" Value="#15803D"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== RadioButton ===================== -->
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <BulletDecorator Background="Transparent">
                        <BulletDecorator.Bullet>
                            <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1.5"
                                    Background="{StaticResource SurfaceBrush}"
                                    SnapsToDevicePixels="True">
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{StaticResource AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Visibility="Collapsed"/>
                            </Border>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TextBox ===================== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource DataFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentDeepBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionOpacity" Value="0.4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== ProgressBar =====================
         net472 在 Win10/11 上的默认 ProgressBar 模板会遵循 Foreground 作为填充色，
         因此只需设置属性即可得到细条 + 医疗蓝填充，无需重写模板。 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="7"/>
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ===================== Border（通用卡片容器） ===================== -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>

    <!-- ===================== 状态条：药丸 ===================== -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="PillLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>

    <!-- 状态条分隔竖线 -->
    <Style x:Key="StatusDivider" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="4,3,12,3"/>
        <Setter Property="Fill" Value="{StaticResource BorderBrush}"/>
    </Style>

    <!-- ===================== ScrollBar（细条） =====================
         注意：必须先于引用它的 ScrollViewer 模板定义——
         同一 ResourceDictionary 内 StaticResource 只能向后查找。 -->
    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BorderStrongBrush}"/>
        <Setter Property="Width" Value="6"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Border CornerRadius="3" Background="Transparent"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBd" CornerRadius="3"
                                                    Background="{StaticResource BorderStrongBrush}" Margin="1"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBd" Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter/>
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Orientation="Vertical"
                                   Style="{StaticResource ThinScrollBar}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Orientation="Horizontal"
                                   Style="{StaticResource ThinScrollBar}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
