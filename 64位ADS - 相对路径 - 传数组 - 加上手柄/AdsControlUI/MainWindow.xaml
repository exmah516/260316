<Window x:Class="AdsControlUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdsControlUI"
        Title="血管介入机器人 · ADS 控制台"
        Height="860" Width="1040"
        MinHeight="700" MinWidth="920"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToGreenRed"   TrueColor="#22C55E" FalseColor="#CBD5E1"/>
        <local:BoolToColorConverter x:Key="BoolToYellowGray" TrueColor="#F59E0B" FalseColor="#CBD5E1"/>
        <local:BoolToColorConverter x:Key="BoolToRedGray"    TrueColor="#EF4444" FalseColor="#CBD5E1"/>
		<local:BoolToColorConverter x:Key="BoolToAdsState"   TrueColor="#22C55E" FalseColor="#EF4444"/>
		<local:BoolToColorConverter x:Key="BoolToAdsDetail"  TrueColor="#475569" FalseColor="#EF4444"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 状态条 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="Auto"/>
				</Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding IsConnected, Converter={StaticResource BoolToGreenRed}}"/>
                            <TextBlock Text="连接" Style="{StaticResource PillLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding ControlActive, Converter={StaticResource BoolToGreenRed}}"/>
                            <TextBlock Text="控制" Style="{StaticResource PillLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding FreezeActive, Converter={StaticResource BoolToYellowGray}}"/>
                            <TextBlock Text="暂停" Style="{StaticResource PillLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding EstopHold, Converter={StaticResource BoolToRedGray}}"/>
                            <TextBlock Text="急停" Style="{StaticResource PillLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding CalZeroed, Converter={StaticResource BoolToGreenRed}}"/>
                            <TextBlock Text="标零" Style="{StaticResource PillLabel}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatusPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10"
                                     Fill="{Binding FfEnabled, Converter={StaticResource BoolToGreenRed}}"/>
                            <TextBlock Text="力反馈" Style="{StaticResource PillLabel}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeText, StringFormat='模式 · {0}'}"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource AccentDeepBrush}" Margin="0,0,14,0"/>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="10,4">
                        <TextBlock Text="{Binding PhaseText}"
                                   Foreground="{StaticResource AccentDeepBrush}"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

				<Border Grid.Row="1" Grid.ColumnSpan="2"
						BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
						Margin="0,8,0,0" Padding="0,8,0,0">
					<WrapPanel VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Margin="0,0,18,2">
							<Ellipse Width="9" Height="9"
									 Fill="{Binding AdsHealthy, Converter={StaticResource BoolToAdsState}}"/>
							<TextBlock Text="{Binding AdsStateText}"
									   Margin="7,0,0,0" FontWeight="SemiBold"
									   Foreground="{Binding AdsHealthy, Converter={StaticResource BoolToAdsState}}"/>
						</StackPanel>
						<TextBlock Text="{Binding AdsDiagnosticsText}" Margin="0,0,18,2"
								   Style="{StaticResource CaptionText}"
								   Foreground="{Binding AdsHealthy, Converter={StaticResource BoolToAdsDetail}}"/>
						<TextBlock Text="{Binding AdsCounterText}" Margin="0,0,0,2"
								   Style="{StaticResource CaptionText}"
								   Foreground="{Binding AdsHealthy, Converter={StaticResource BoolToAdsDetail}}"/>
					</WrapPanel>
				</Border>
            </Grid>
        </Border>

        <!-- 主内容 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：模式选择与平移轴行程 -->
            <ScrollViewer Grid.Column="0" Margin="0,0,8,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                <GroupBox Header="模式选择">
                    <StackPanel>
                        <UniformGrid Columns="2" Margin="2">
                            <RadioButton Content="导管递送" GroupName="Mode" Style="{StaticResource ModeChipRadio}"
                                         Click="ModeCathFwd_Click" IsChecked="{Binding ModeCathFwdSelected, Mode=OneWay}"
                                         IsEnabled="{Binding ModeSwitchAllowed}"/>
                            <RadioButton Content="导管撤出" GroupName="Mode" Style="{StaticResource ModeChipRadio}"
                                         Click="ModeCathRev_Click" IsChecked="{Binding ModeCathRevSelected, Mode=OneWay}"
                                         IsEnabled="{Binding ModeSwitchAllowed}"/>
                            <RadioButton Content="导丝递送" GroupName="Mode" Style="{StaticResource ModeChipRadio}"
                                         Click="ModeGuideFwd_Click" IsChecked="{Binding ModeGuideFwdSelected, Mode=OneWay}"
                                         IsEnabled="{Binding ModeSwitchAllowed}"/>
                            <RadioButton Content="导丝撤出" GroupName="Mode" Style="{StaticResource ModeChipRadio}"
                                         Click="ModeGuideRev_Click" IsChecked="{Binding ModeGuideRevSelected, Mode=OneWay}"
                                         IsEnabled="{Binding ModeSwitchAllowed}"/>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="2,0,2,2" Visibility="Collapsed">
                            <RadioButton Content="协同递送" GroupName="Mode" Style="{StaticResource ModeChipRadio}"
                                         Click="ModeCooperativeDelivery_Click"
                                         IsChecked="{Binding ModeCooperativeDeliverySelected, Mode=OneWay}"
                                         IsEnabled="{Binding CooperativeModeEnabled}"/>
                            <RadioButton Content="协同撤出" GroupName="Mode" Style="{StaticResource ModeChipRadio}"
                                         Click="ModeCooperativeRetraction_Click"
                                         IsChecked="{Binding ModeCooperativeRetractionSelected, Mode=OneWay}"
                                         IsEnabled="{Binding CooperativeModeEnabled}"/>
                        </UniformGrid>
                        <TextBlock Text="{Binding CooperativeStatusText}"
                                   Style="{StaticResource CaptionText}"
                                   Margin="6,0,6,4"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PhysicalButtonNoticeText}"
                                   Style="{StaticResource ErrorText}"
                                   FontSize="11" Margin="6,0,6,4"
                                   TextWrapping="Wrap"/>

                        <!-- 屈曲恢复与导管回退完成后的轴1自动先行量 -->
                        <Border BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="2,6,2,0" Padding="0,10,0,0">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,6" VerticalAlignment="Center">
                                    <ToggleButton Content="屈曲恢复"
                                                  IsChecked="{Binding SpacingRecoveryActive, Mode=OneWay}"
                                                  Click="SpacingRecovery_Click"
                                                  MinWidth="112" MinHeight="38" Margin="0,0,12,0"/>
                                    <TextBlock Text="回退完成后轴1自动先行量"
                                               Style="{StaticResource FieldLabelText}"
                                               VerticalAlignment="Center"
                                               ToolTip="导管回退完成后轴1自动沿递送方向先行，范围 0~10 mm"/>
                                    <TextBox x:Name="TbAxis1PostReturnLead"
                                             Text="1.00" Width="72" Margin="8,2,0,2"
                                             VerticalContentAlignment="Center"
                                             ToolTip="单位 mm，允许范围 0~10；输入 0 可关闭自动先行"/>
                                    <Button Content="应用" Click="ApplyAxis1PostReturnLead_Click"
                                            Padding="12,7" Margin="8,0,0,0"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding SpacingRecoveryStatusText}"
                                           Style="{StaticResource CaptionText}"
                                           Margin="0,0,0,4" TextWrapping="Wrap"/>
                                <TextBlock x:Name="Axis1LeadError" Style="{StaticResource ErrorText}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Axis6SoftLimitText}"
                                           Style="{StaticResource CaptionText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="轴位置 / 已行进行程" Margin="0,12,0,0">
                    <StackPanel Margin="2">
                        <!-- 轴1 -->
                        <Border Style="{StaticResource AxisRowBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding Axis1StrokeText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ProgressBar Height="10"
                                             Value="{Binding Axis1EffectiveTravel, Mode=OneWay}"
                                             Minimum="0" Maximum="{Binding Axis1StrokeMax}"/>
                            </StackPanel>
                        </Border>

                        <!-- 轴2：仅显示角度数字 -->
                        <Border Style="{StaticResource AxisRowBorder}" Padding="10,6">
                            <TextBlock Text="{Binding Axis2RotationText}" FontWeight="SemiBold"/>
                        </Border>

                        <!-- 轴3 -->
                        <Border Style="{StaticResource AxisRowBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding Axis3StrokeText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ProgressBar Height="10"
                                             Value="{Binding Axis3EffectiveTravel, Mode=OneWay}"
                                             Minimum="0" Maximum="{Binding Axis3StrokeMax}"/>
                            </StackPanel>
                        </Border>

                        <!-- 轴4 -->
                        <Border Style="{StaticResource AxisRowBorder}">
                            <TextBlock Text="{Binding Axis4RotationText}" FontWeight="SemiBold"/>
                        </Border>

                        <!-- 轴5 -->
                        <Border Style="{StaticResource AxisRowBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding Axis5StrokeText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ProgressBar Height="10"
                                             Value="{Binding Axis5EffectiveTravel, Mode=OneWay}"
                                             Minimum="0" Maximum="{Binding Axis5StrokeMax}"/>
                            </StackPanel>
                        </Border>

                        <!-- 轴6 -->
                        <Border Style="{StaticResource AxisRowBorder}">
                            <StackPanel>
                                <TextBlock Text="{Binding Axis6StrokeText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ProgressBar Height="10"
                                             Value="{Binding Axis6EffectiveTravel, Mode=OneWay}"
                                             Minimum="0" Maximum="{Binding Axis6StrokeMax}"/>
                            </StackPanel>
                        </Border>

                        <!-- 轴7：仅显示角度数字 -->
                        <Border Style="{StaticResource AxisRowBorder}" Padding="10,6" Margin="0">
                            <TextBlock Text="{Binding Axis7RotationText}" FontWeight="SemiBold"/>
                        </Border>

                    </StackPanel>
                </GroupBox>

                <GroupBox Header="定位臂手动控制" Margin="0,12,0,0">
                    <StackPanel Margin="2">
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Content="总使能"
                                          IsChecked="{Binding ArmManualEnabled, Mode=OneWay}"
                                          IsEnabled="{Binding ArmManualAvailable}"
                                          Click="ArmManualEnable_Click"
                                          MinWidth="86" MinHeight="34" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ArmManualStatusText}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding ArmAxes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AxisRowBorder}">
                                        <StackPanel>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AxisLabel}"
                                                           FontWeight="SemiBold" MinWidth="88"
                                                           VerticalAlignment="Center"/>
                                                <ToggleButton Content="上电"
                                                              Tag="{Binding AxisNumber}"
                                                              IsChecked="{Binding EnableRequested, Mode=OneWay}"
                                                              IsEnabled="{Binding DataContext.ArmAxisControlsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                              Click="ArmAxisEnable_Click"
                                                              MinWidth="52" MinHeight="31" Margin="3"/>
                                                <Button Content="复位" Tag="{Binding AxisNumber}"
                                                        IsEnabled="{Binding DataContext.ArmAxisControlsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Click="ArmAxisReset_Click"
                                                        Padding="10,5" Margin="3"/>
                                                <Button Content="Jog-" Tag="{Binding AxisNumber}" CommandParameter="-1"
                                                        IsEnabled="{Binding DataContext.ArmAxisControlsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        PreviewMouseLeftButtonDown="ArmJogButton_PreviewMouseLeftButtonDown"
                                                        PreviewMouseLeftButtonUp="ArmJogButton_PreviewMouseLeftButtonUp"
                                                        LostMouseCapture="ArmJogButton_LostMouseCapture"
                                                        Padding="10,5" Margin="3"
                                                        ToolTip="按住反向点动，松开立即停止"/>
                                                <Button Content="Jog+" Tag="{Binding AxisNumber}" CommandParameter="1"
                                                        IsEnabled="{Binding DataContext.ArmAxisControlsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        PreviewMouseLeftButtonDown="ArmJogButton_PreviewMouseLeftButtonDown"
                                                        PreviewMouseLeftButtonUp="ArmJogButton_PreviewMouseLeftButtonUp"
                                                        LostMouseCapture="ArmJogButton_LostMouseCapture"
                                                        Padding="10,5" Margin="3"
                                                        ToolTip="按住正向点动，松开立即停止"/>
                                            </WrapPanel>

                                            <WrapPanel Margin="0,5,0,0" VerticalAlignment="Center"
                                                       IsEnabled="{Binding DataContext.ArmAxisControlsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                                <TextBlock Text="Vel" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding VelocityInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55" Margin="4,0,8,0" ToolTip="点动速度，单位跟随 NC Axis"/>
                                                <TextBlock Text="Acc" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding AccelerationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55" Margin="4,0,8,0" ToolTip="点动加速度，单位跟随 NC Axis"/>
                                                <TextBlock Text="Dec" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding DecelerationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="55" Margin="4,0,8,0" ToolTip="点动减速度，单位跟随 NC Axis"/>
                                                <TextBlock Text="Jerk" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding JerkInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="64" Margin="4,0,8,0" ToolTip="点动加加速度，单位跟随 NC Axis"/>
                                                <Button Content="应用" Click="ApplyArmJogParameters_Click"
                                                        Padding="10,4"/>
                                            </WrapPanel>

                                            <WrapPanel Margin="0,5,0,0">
                                                <TextBlock Text="位置 " Style="{StaticResource CaptionText}"/>
                                                <TextBlock Text="{Binding PositionText}" FontWeight="SemiBold"/>
                                                <TextBlock Text="    速度 " Style="{StaticResource CaptionText}"/>
                                                <TextBlock Text="{Binding VelocityText}" FontWeight="SemiBold"/>
                                                <TextBlock Text="    " />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding ParameterErrorText}"
                                                       Style="{StaticResource ErrorText}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧控制 -->
            <ScrollViewer Grid.Column="1" Margin="8,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 启动准备 -->
                    <GroupBox Grid.Row="0" Header="启动准备">
                        <StackPanel Margin="2">
                            <Grid Margin="0,2,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="128"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="轴1 (5–95 mm)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbAxis1" Text="20"  Margin="8,3"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="轴3 (10–650 mm)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbAxis3" Text="649" Margin="8,3"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="轴5 (10–670 mm)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbAxis5" Text="649" Margin="8,3"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="轴6 (10–670 mm)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TbAxis6" Text="650" Margin="8,3"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="轴2 (−360~360°)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbAxis2" Text="0"   Margin="8,3"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="轴7 (−360~360°)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TbAxis7" Text="0"   Margin="8,3"/>
                                <TextBlock Grid.Row="6" Grid.Column="0" Text="速度比例" Style="{StaticResource FieldLabelText}"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TbSpeed" Text="0.03" Margin="8,3"/>
                            </Grid>

                            <TextBlock x:Name="StartupError" Style="{StaticResource ErrorText}" Margin="0,4,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="执行启动准备 (S)" Click="ExecuteStartup_Click"
                                        Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,8,0"/>
                                <Button Content="直接控制 (C)" Click="DirectControl_Click" Padding="16,8"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 力反馈 -->
                    <GroupBox Grid.Row="1" Header="力反馈">
                        <StackPanel Margin="2">
                            <WrapPanel>
                                <Button Content="零点采集"   Click="Zero_Click"      Margin="0,0,8,6" Padding="12,7"/>
                                <Button Content="力反馈开关" Click="FfToggle_Click"  Margin="0,0,8,6" Padding="12,7"/>
                                <Button Content="实际反馈窗口" Click="ShowForce_Click" Margin="0,0,8,6" Padding="12,7"/>
                                <Button Content="纯净力感窗口" Click="ShowCleanForce_Click" Margin="0,0,8,6" Padding="12,7"/>
                                <Button Content="力过渡实验" Click="ShowFtExp_Click" Margin="0,0,8,6" Padding="12,7"/>
                                <ToggleButton x:Name="GravityCompCheckBox" Content="重力补偿"
                                              IsChecked="{Binding GravityCompEnabled, Mode=OneWay}"
                                              Click="GravityComp_Click" Margin="0,0,8,6" Padding="12,7"/>
                                <ToggleButton x:Name="ForceFeedbackHoldCheckBox" Content="力反馈-保持"
                                              IsChecked="{Binding ForceFeedbackHoldEnabled, Mode=OneWay}"
                                              IsEnabled="{Binding IsConnected}"
                                              Click="ForceFeedbackHold_Click" Margin="0,0,8,6" Padding="12,7"
                                              ToolTip="自动换手恢复夹爪时，将当前反馈力/力矩保持200ms后再恢复实时反馈"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding ForceFeedbackHoldStatusText}"
                                       Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ForcePlotError" Style="{StaticResource ErrorText}" Margin="0,0,0,8"/>

                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                                        <TextBlock Text="实际下发轴向力" Style="{StaticResource CaptionText}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Force582F, StringFormat='{}{0:F3} N'}"
                                                   Style="{StaticResource DataValueText}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SeriesForceBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                                        <TextBlock Text="实际下发力矩" Style="{StaticResource CaptionText}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Force582N, StringFormat='{}{0:F5} N·m'}"
                                                   Style="{StaticResource DataValueText}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SeriesTorqueBrush}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2"
                                               Text="{Binding CalZeroed, StringFormat='已标零：{0}'}"
                                               Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- 统一实验记录 -->
                    <GroupBox Grid.Row="2" Header="实验记录">
                        <StackPanel Margin="2">
                            <TextBlock Text="实验名称" Style="{StaticResource FieldLabelText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="TbExperimentName"
                                     MaxLength="64"
                                     IsEnabled="{Binding ExperimentNameEditable}"
                                     MinHeight="34"
                                     Padding="8,5"
                                     Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="开始实验记录"
                                        Click="StartExperimentRecording_Click"
                                        IsEnabled="{Binding CanStartExperimentRecording}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="14,8" Margin="0,0,8,4"/>
                                <Button Content="停止实验记录"
                                        Click="StopExperimentRecording_Click"
                                        IsEnabled="{Binding CanStopExperimentRecording}"
                                        Padding="14,8" Margin="0,0,8,4"/>
                                <Button Content="相机预览"
                                        Click="ShowCameraPreview_Click"
                                        IsEnabled="{Binding CanOpenCameraPreview}"
                                        Padding="14,8" Margin="0,0,8,4"/>
                            </WrapPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding RecordingStateText}"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding RecordingLossText}"
                                           Style="{StaticResource CaptionText}" Margin="12,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding RecordingElapsedText}"
                                           Style="{StaticResource DataValueText}" FontWeight="SemiBold"/>
                            </Grid>
                            <TextBlock Text="{Binding CameraStatusText}"
                                       Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding CameraParameterText}"
                                       Style="{StaticResource CaptionText}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RecordingErrorText}"
                                       Style="{StaticResource ErrorText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 主从位移补偿 -->
                    <GroupBox Grid.Row="3" Header="主从位移补偿">
                        <StackPanel Margin="2">
                            <WrapPanel Margin="0,0,0,6">
                                <ToggleButton Content="位移补偿"
                                              IsChecked="{Binding TrackingCompensationEnabled, Mode=OneWay}"
                                              IsEnabled="{Binding TrackingCompensationToggleEnabled}"
                                              Click="TrackingCompensation_Click"
                                              Margin="0,0,8,4" Padding="12,7"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding TrackingStatusText}"
                                       Style="{StaticResource CaptionText}"
                                       Margin="0,0,0,8" TextWrapping="Wrap"/>

                            <Grid IsEnabled="{Binding TrackingParametersEditable}" Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="轴" Style="{StaticResource FieldLabelText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Kp" Style="{StaticResource FieldLabelText}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ki" Style="{StaticResource FieldLabelText}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="最大增益" Style="{StaticResource FieldLabelText}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="欠账上界 mm" Style="{StaticResource FieldLabelText}" HorizontalAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="轴1" Style="{StaticResource FieldLabelText}"/>
								<TextBox Grid.Row="1" Grid.Column="1" x:Name="TbTrackAxis1Kp" Text="0.5" Margin="3" MinWidth="54"/>
								<TextBox Grid.Row="1" Grid.Column="2" x:Name="TbTrackAxis1Ki" Text="2" Margin="3" MinWidth="54"/>
								<TextBox Grid.Row="1" Grid.Column="3" x:Name="TbTrackAxis1Gain" Text="2" Margin="3" MinWidth="54"/>
                                <TextBox Grid.Row="1" Grid.Column="4" x:Name="TbTrackAxis1Error" Text="20.00" Margin="3" MinWidth="54"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="轴6" Style="{StaticResource FieldLabelText}"/>
								<TextBox Grid.Row="2" Grid.Column="1" x:Name="TbTrackAxis6Kp" Text="0.5" Margin="3" MinWidth="54"/>
								<TextBox Grid.Row="2" Grid.Column="2" x:Name="TbTrackAxis6Ki" Text="2" Margin="3" MinWidth="54"/>
								<TextBox Grid.Row="2" Grid.Column="3" x:Name="TbTrackAxis6Gain" Text="2" Margin="3" MinWidth="54"/>
                                <TextBox Grid.Row="2" Grid.Column="4" x:Name="TbTrackAxis6Error" Text="20.00" Margin="3" MinWidth="54"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="应用参数" Click="ApplyTrackingParams_Click"
                                        IsEnabled="{Binding TrackingParametersEditable}" Padding="12,7" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TrackingError" Style="{StaticResource ErrorText}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 电缸 -->
                    <GroupBox Grid.Row="4" Header="电缸控制" IsEnabled="{Binding SpacingRecoveryInactive}">
                        <UniformGrid Columns="2" Margin="2">
                            <ToggleButton Content="电缸 1" IsChecked="{Binding Cyl1Open, Mode=OneWay}" Click="Cyl1_Click" Margin="3" MinHeight="40"/>
                            <ToggleButton Content="电缸 2" IsChecked="{Binding Cyl2Open, Mode=OneWay}" Click="Cyl2_Click" Margin="3" MinHeight="40"/>
                            <ToggleButton Content="电缸 3" IsChecked="{Binding Cyl3Open, Mode=OneWay}" Click="Cyl3_Click" Margin="3" MinHeight="40"/>
                            <ToggleButton Content="电缸 4" IsChecked="{Binding Cyl4Open, Mode=OneWay}" Click="Cyl4_Click" Margin="3" MinHeight="40"/>
                        </UniformGrid>
                    </GroupBox>

					<!-- 辅助执行器 -->
					<GroupBox Grid.Row="5" Header="辅助执行器控制"
							  IsEnabled="{Binding Axis4ManualControlAllowed}">
						<Grid Margin="2">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="92"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Grid.Row="0" Grid.Column="0" Text="球囊" Style="{StaticResource FieldLabelText}"/>
							<Button Grid.Row="0" Grid.Column="1" Content="球囊撤出" CommandParameter="-1"
									PreviewMouseLeftButtonDown="Axis4JogButton_PreviewMouseLeftButtonDown"
									PreviewMouseLeftButtonUp="Axis4JogButton_PreviewMouseLeftButtonUp"
									LostMouseCapture="Axis4JogButton_LostMouseCapture" Margin="3" MinHeight="38"/>
							<Button Grid.Row="0" Grid.Column="2" Content="球囊输送" CommandParameter="1"
									PreviewMouseLeftButtonDown="Axis4JogButton_PreviewMouseLeftButtonDown"
									PreviewMouseLeftButtonUp="Axis4JogButton_PreviewMouseLeftButtonUp"
									LostMouseCapture="Axis4JogButton_LostMouseCapture" Margin="3" MinHeight="38"/>

							<TextBlock Grid.Row="1" Grid.Column="0" Text="Y阀" Style="{StaticResource FieldLabelText}"/>
							<Button Grid.Row="1" Grid.Column="1" Content="Y阀打开" Click="YValveOpen_Click" Margin="3" MinHeight="38"/>
							<Button Grid.Row="1" Grid.Column="2" Content="Y阀关闭" Click="YValveClose_Click" Margin="3" MinHeight="38"/>

							<TextBlock Grid.Row="2" Grid.Column="0" Text="注射器1" Style="{StaticResource FieldLabelText}"/>
							<Button Grid.Row="2" Grid.Column="1" Content="拉" Tag="1" CommandParameter="-1"
									PreviewMouseLeftButtonDown="InjectorJogButton_PreviewMouseLeftButtonDown"
									PreviewMouseLeftButtonUp="InjectorJogButton_PreviewMouseLeftButtonUp"
									LostMouseCapture="InjectorJogButton_LostMouseCapture" Margin="3" MinHeight="38"/>
							<Button Grid.Row="2" Grid.Column="2" Content="推" Tag="1" CommandParameter="1"
									PreviewMouseLeftButtonDown="InjectorJogButton_PreviewMouseLeftButtonDown"
									PreviewMouseLeftButtonUp="InjectorJogButton_PreviewMouseLeftButtonUp"
									LostMouseCapture="InjectorJogButton_LostMouseCapture" Margin="3" MinHeight="38"/>

							<TextBlock Grid.Row="3" Grid.Column="0" Text="注射器2" Style="{StaticResource FieldLabelText}"/>
							<Button Grid.Row="3" Grid.Column="1" Content="拉" Tag="2" CommandParameter="-1"
									PreviewMouseLeftButtonDown="InjectorJogButton_PreviewMouseLeftButtonDown"
									PreviewMouseLeftButtonUp="InjectorJogButton_PreviewMouseLeftButtonUp"
									LostMouseCapture="InjectorJogButton_LostMouseCapture" Margin="3" MinHeight="38"/>
							<Button Grid.Row="3" Grid.Column="2" Content="推" Tag="2" CommandParameter="1"
									PreviewMouseLeftButtonDown="InjectorJogButton_PreviewMouseLeftButtonDown"
									PreviewMouseLeftButtonUp="InjectorJogButton_PreviewMouseLeftButtonUp"
									LostMouseCapture="InjectorJogButton_LostMouseCapture" Margin="3" MinHeight="38"/>
						</Grid>
					</GroupBox>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
