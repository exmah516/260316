<Window x:Class="AdsControlUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdsControlUI"
        Title="ADS 控制可视化" Height="760" Width="820"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:BoolToColorConverter x:Key="BoolToGreenRed"   TrueColor="#22C55E" FalseColor="#CBD5E1"/>
        <local:BoolToColorConverter x:Key="BoolToYellowGray" TrueColor="#F59E0B" FalseColor="#CBD5E1"/>
        <local:BoolToColorConverter x:Key="BoolToRedGray"    TrueColor="#EF4444" FalseColor="#CBD5E1"/>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ 状态条：药丸式指示灯 ============ -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12,8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToGreenRed}}"/>
                        <TextBlock Text="连接" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding ControlActive, Converter={StaticResource BoolToGreenRed}}"/>
                        <TextBlock Text="控制" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding FreezeActive, Converter={StaticResource BoolToYellowGray}}"/>
                        <TextBlock Text="暂停" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatusPill}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10"
                                 Fill="{Binding EstopHold, Converter={StaticResource BoolToRedGray}}"/>
                        <TextBlock Text="急停" Style="{StaticResource PillLabel}"/>
                    </StackPanel>
                </Border>

                <Rectangle Style="{StaticResource StatusDivider}"/>

                <TextBlock Text="{Binding ModeText, StringFormat='模式 · {0}'}"
                           FontWeight="SemiBold" Foreground="{StaticResource AccentDeepBrush}"/>

                <Rectangle Style="{StaticResource StatusDivider}"/>

                <TextBlock Text="{Binding PhaseText}" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ============ 主内容 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：轴位置 -->
            <GroupBox Grid.Column="0" Header="轴位置 / 有效行程" Margin="0,0,7,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="2">
                        <!-- 轴1 -->
                        <TextBlock Text="{Binding Axis1StrokeText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <ProgressBar Value="{Binding Axis1EffectiveTravel, Mode=OneWay}" Minimum="0" Maximum="{Binding Axis1StrokeMax}" Margin="0,0,0,10"/>

                        <!-- 轴2 旋转 -->
                        <TextBlock Text="{Binding Axis2RotationText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <local:CircularAxisIndicator Angle="{Binding Axis2Pos, Mode=OneWay}" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <!-- 轴3 -->
                        <TextBlock Text="{Binding Axis3StrokeText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <ProgressBar Value="{Binding Axis3EffectiveTravel, Mode=OneWay}" Minimum="0" Maximum="{Binding Axis3StrokeMax}" Margin="0,0,0,10"/>

                        <!-- 轴4 旋转 -->
                        <TextBlock Text="{Binding Axis4RotationText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <local:CircularAxisIndicator Angle="{Binding Axis4Pos, Mode=OneWay}" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                        <!-- 轴5 -->
                        <TextBlock Text="{Binding Axis5StrokeText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <ProgressBar Value="{Binding Axis5EffectiveTravel, Mode=OneWay}" Minimum="0" Maximum="{Binding Axis5StrokeMax}" Margin="0,0,0,10"/>

                        <!-- 轴6 -->
                        <TextBlock Text="{Binding Axis6StrokeText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <ProgressBar Value="{Binding Axis6EffectiveTravel, Mode=OneWay}" Minimum="0" Maximum="{Binding Axis6StrokeMax}" Margin="0,0,0,10"/>

                        <!-- 轴7 旋转 -->
                        <TextBlock Text="{Binding Axis7RotationText}" FontWeight="SemiBold" Margin="0,2,0,3"/>
                        <local:CircularAxisIndicator Angle="{Binding Axis7Pos, Mode=OneWay}" Width="64" Height="64" HorizontalAlignment="Left" Margin="0,0,0,2"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>

            <!-- 右侧：控制（窗口不够高时可垂直滚动） -->
            <ScrollViewer Grid.Column="1" Margin="7,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- 电缸控制 -->
                <GroupBox Header="电缸控制">
                    <UniformGrid Columns="2" Margin="2">
                        <ToggleButton Content="电缸 1" IsChecked="{Binding Cyl1Open, Mode=OneWay}" Click="Cyl1_Click" Margin="3"/>
                        <ToggleButton Content="电缸 2" IsChecked="{Binding Cyl2Open, Mode=OneWay}" Click="Cyl2_Click" Margin="3"/>
                        <ToggleButton Content="电缸 3" IsChecked="{Binding Cyl3Open, Mode=OneWay}" Click="Cyl3_Click" Margin="3"/>
                        <ToggleButton Content="电缸 4" IsChecked="{Binding Cyl4Open, Mode=OneWay}" Click="Cyl4_Click" Margin="3"/>
                    </UniformGrid>
                </GroupBox>

                <!-- 模式切换 -->
                <GroupBox Header="模式切换">
                    <UniformGrid Columns="2" Margin="2">
                        <RadioButton Content="导管递送" GroupName="Mode" Click="ModeCathFwd_Click" IsChecked="{Binding ModeCathFwdSelected, Mode=OneWay}" Margin="3"/>
                        <RadioButton Content="导管撤出" GroupName="Mode" Click="ModeCathRev_Click" IsChecked="{Binding ModeCathRevSelected, Mode=OneWay}" Margin="3"/>
                        <RadioButton Content="导丝递送" GroupName="Mode" Click="ModeGuideFwd_Click" IsChecked="{Binding ModeGuideFwdSelected, Mode=OneWay}" Margin="3"/>
                        <RadioButton Content="导丝撤出" GroupName="Mode" Click="ModeGuideRev_Click" IsChecked="{Binding ModeGuideRevSelected, Mode=OneWay}" Margin="3"/>
                    </UniformGrid>
                </GroupBox>

                <!-- 力反馈 -->
                <GroupBox Header="力反馈">
                    <StackPanel Margin="2">
                        <WrapPanel>
                            <Button Content="零点采集"   Click="Zero_Click"      Margin="0,0,8,4" Padding="12,6"/>
                            <Button Content="力反馈开关" Click="FfToggle_Click"  Margin="0,0,8,4" Padding="12,6"/>
                            <Button Content="显示实时力" Click="ShowForce_Click" Margin="0,0,8,4" Padding="12,6"/>
                            <Button Content="力过渡实验" Click="ShowFtExp_Click" Margin="0,0,8,4" Padding="12,6"/>
                            <ToggleButton x:Name="GravityCompCheckBox" Content="重力补偿"
                                          IsChecked="{Binding GravityCompEnabled, Mode=OneWay}"
                                          Click="GravityComp_Click" Margin="0,0,8,4" Padding="12,6"/>
                            <ToggleButton Content="数据记录" IsChecked="{Binding ForceLogRunning, Mode=OneWay}"
                                          Click="ForceLog_Click" Margin="0,0,8,4" Padding="12,6"/>
                        </WrapPanel>
                        <TextBlock x:Name="ForcePlotError" Style="{StaticResource ErrorText}" Margin="0,2,0,6"/>

                        <!-- 力读数：等宽对齐 -->
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="10,8" Margin="0,2,0,0">
                            <StackPanel>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="10" Height="3" VerticalAlignment="Center" Fill="{StaticResource SeriesForceBrush}" RadiusX="1.5" RadiusY="1.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Force582F, StringFormat='F  actual  =  {0:F3}  N'}" Style="{StaticResource DataValueText}"/>
                                </Grid>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Width="10" Height="3" VerticalAlignment="Center" Fill="{StaticResource SeriesTorqueBrush}" RadiusX="1.5" RadiusY="1.5"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Force582N, StringFormat='T  actual  =  {0:F5}  N·m'}" Style="{StaticResource DataValueText}"/>
                                </Grid>
                                <Border Background="{StaticResource BorderBrush}" Height="1" Margin="0,5,0,5"/>
                                <TextBlock Text="{Binding Force582TheoryF, StringFormat='F  theory  =  {0:F3}  N'}" Style="{StaticResource DataValueText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,1,0,1"/>
                                <TextBlock Text="{Binding Force582TheoryN, StringFormat='T  theory  =  {0:F5}  N·m'}" Style="{StaticResource DataValueText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="20,1,0,1"/>
                                <TextBlock Text="{Binding CalZeroed, StringFormat='已标零 :  {0}'}" Style="{StaticResource CaptionText}" Margin="20,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 启动准备 -->
                <GroupBox Header="启动准备">
                    <StackPanel Margin="2">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="轴 1 (5–95 mm):"  Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbAxis1" Text="20"  Margin="8,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="轴 3 (10–650 mm):" Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbAxis3" Text="635" Margin="8,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="轴 5 (10–670 mm):" Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TbAxis5" Text="290" Margin="8,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="轴 6 (10–670 mm):" Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="3" Grid.Column="1" x:Name="TbAxis6" Text="310" Margin="8,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="轴 2 (−360~360°):" Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="4" Grid.Column="1" x:Name="TbAxis2" Text="0"   Margin="8,3"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="轴 7 (−360~360°):" Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="5" Grid.Column="1" x:Name="TbAxis7" Text="0"   Margin="8,3"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="速度比例:"          Style="{StaticResource FieldLabelText}" Margin="0,3"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TbSpeed" Text="0.005" Margin="8,3"/>
                        </Grid>

                        <TextBlock x:Name="StartupError" Style="{StaticResource ErrorText}" Margin="0,6,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="执行启动准备 (S)" Click="ExecuteStartup_Click" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                            <Button Content="直接控制 (C)"     Click="DirectControl_Click"  Padding="14,7"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
