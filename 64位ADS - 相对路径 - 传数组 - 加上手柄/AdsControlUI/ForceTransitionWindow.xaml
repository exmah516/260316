<Window x:Class="AdsControlUI.ForceTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        Title="力过渡决定性预实验 (论文 §6.1)" Height="860" Width="1180"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左列：参数表单 + 控制 + 状态 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="4">
                <GroupBox Header="实验参数">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="档位数 N (2-6):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbNumLevels" Text="4" Margin="4,2"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="速度1 v1 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbV1" Text="25" Margin="4,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="速度2 v2 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbV2" Text="50" Margin="4,2"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="速度3 v3 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TbV3" Text="75" Margin="4,2"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="速度4 v4 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TbV4" Text="100" Margin="4,2"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="速度5 v5 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TbV5" Text="0" Margin="4,2"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="速度6 v6 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TbV6" Text="0" Margin="4,2"/>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="每档重复 M:" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TbRepeats" Text="3" Margin="4,2"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="起始位置 (mm):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TbStartPos" Text="10" Margin="4,2"/>
                        <TextBlock Grid.Row="9" Grid.Column="0" Text="推送目标 (mm):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="9" Grid.Column="1" x:Name="TbPushTarget" Text="70" Margin="4,2"/>
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="回退触发 (mm):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TbReturnTrigger" Text="85" Margin="4,2"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="节奏" Margin="0,8,0,0">
                    <Grid Margin="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="接近速度比例 (%):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbApproachRatio" Text="20" Margin="4,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="档间静置 (ms):" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TbDwellMs" Text="1500" Margin="4,2"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="控制" Margin="0,8,0,0">
                    <StackPanel Margin="6">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnStart" Content="开始实验" Click="BtnStart_Click" Padding="12,6" Margin="0,0,8,0"/>
                            <Button x:Name="BtnStop" Content="停止实验" Click="BtnStop_Click" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="实验状态" Margin="0,8,0,0">
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding FtExpPhaseText, StringFormat='相位: {0}'}"/>
                        <TextBlock Text="{Binding FtExpVelocityLevel, StringFormat='档位: {0}'}"/>
                        <TextBlock Text="{Binding FtExpRepeatInLevel, StringFormat='档内重复: {0}'}"/>
                        <TextBlock Text="{Binding FtExpTrialId, StringFormat='全局试次号: {0}'}"/>
                        <TextBlock Text="{Binding FtExpVRatioCurr, StringFormat='当前 v 比例: {0:F3}'}"/>
                        <TextBlock Text="{Binding FtExpAxis1Target, StringFormat='axis1 目标: {0:F2} mm'}"/>
                        <TextBlock Text="{Binding FtExpActive, StringFormat='active: {0}'}"/>
                        <TextBlock x:Name="AbortIndicator" Foreground="Red" Visibility="Collapsed" Text="实验已中止"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="绘图操作" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="6">
                        <Button Content="清空曲线" Click="BtnClear_Click" Padding="8,4" Margin="0,0,8,0"/>
                        <Button Content="导出 PNG" Click="BtnExport_Click" Padding="8,4"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 右列：双视图 -->
        <Grid Grid.Column="1" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="F vs t (秒)">
                <scottplot:WpfPlot x:Name="PlotFt"/>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="F vs 从端位移 axis1 (mm)" Margin="0,8,0,0">
                <scottplot:WpfPlot x:Name="PlotFx"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
