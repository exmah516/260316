<Window x:Class="AdsControlUI.ForceTransitionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        Title="力过渡决定性预实验 (论文 §6.1)" Height="880" Width="1200"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左列：参数 + 控制 + 状态 ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel Margin="2">

                <!-- 实验参数 -->
                <GroupBox Header="实验参数">
                    <Grid Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"  Grid.Column="0" Text="档位数 N (2–6)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="0"  Grid.Column="1" x:Name="TbNumLevels" Text="4"  Margin="6,2"/>

                        <TextBlock Grid.Row="1"  Grid.Column="0" Text="速度 1 v1 (%)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="1"  Grid.Column="1" x:Name="TbV1" Text="25"  Margin="6,2"/>
                        <TextBlock Grid.Row="2"  Grid.Column="0" Text="速度 2 v2 (%)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="2"  Grid.Column="1" x:Name="TbV2" Text="50"  Margin="6,2"/>
                        <TextBlock Grid.Row="3"  Grid.Column="0" Text="速度 3 v3 (%)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="3"  Grid.Column="1" x:Name="TbV3" Text="75"  Margin="6,2"/>
                        <TextBlock Grid.Row="4"  Grid.Column="0" Text="速度 4 v4 (%)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="4"  Grid.Column="1" x:Name="TbV4" Text="100" Margin="6,2"/>
                        <TextBlock Grid.Row="5"  Grid.Column="0" Text="速度 5 v5 (%)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="5"  Grid.Column="1" x:Name="TbV5" Text="0"   Margin="6,2"/>
                        <TextBlock Grid.Row="6"  Grid.Column="0" Text="速度 6 v6 (%)"  Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="6"  Grid.Column="1" x:Name="TbV6" Text="0"   Margin="6,2"/>

                        <TextBlock Grid.Row="7"  Grid.Column="0" Text="每档重复 M"     Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="7"  Grid.Column="1" x:Name="TbRepeats" Text="3" Margin="6,2"/>

                        <TextBlock Grid.Row="8"  Grid.Column="0" Text="起始位置 (mm)"   Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="8"  Grid.Column="1" x:Name="TbStartPos" Text="10" Margin="6,2"/>
                        <TextBlock Grid.Row="9"  Grid.Column="0" Text="推送目标 (mm)"   Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="9"  Grid.Column="1" x:Name="TbPushTarget" Text="70" Margin="6,2"/>
                        <TextBlock Grid.Row="10" Grid.Column="0" Text="回退触发 (mm)"   Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TbReturnTrigger" Text="85" Margin="6,2"/>
                    </Grid>
                </GroupBox>

                <!-- 节奏 -->
                <GroupBox Header="节奏">
                    <Grid Margin="2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="接近速度比例 (%)" Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbApproachRatio" Text="20" Margin="6,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="档间静置 (ms)"      Style="{StaticResource FieldLabelText}"/>
                        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbDwellMs" Text="1500" Margin="6,2"/>
                    </Grid>
                </GroupBox>

                <!-- 控制 -->
                <GroupBox Header="控制">
                    <StackPanel Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnStart" Content="开始实验" Click="BtnStart_Click" Style="{StaticResource PrimaryButton}" Padding="14,7" Margin="0,0,8,0"/>
                            <Button x:Name="BtnStop"  Content="停止实验" Click="BtnStop_Click"  Padding="14,7"/>
                        </StackPanel>
                        <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Margin="0,8,0,0" MinHeight="16"/>
                    </StackPanel>
                </GroupBox>

                <!-- 实验状态 -->
                <GroupBox Header="实验状态">
                    <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Padding="10,8" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="相位" Style="{StaticResource CaptionText}" Margin="0,3"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FtExpPhaseText}" Style="{StaticResource DataValueText}" FontWeight="SemiBold" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="档位" Style="{StaticResource CaptionText}" Margin="0,3"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FtExpVelocityLevel}" Style="{StaticResource DataValueText}" Margin="0,3"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="档内重复" Style="{StaticResource CaptionText}" Margin="0,3"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FtExpRepeatInLevel}" Style="{StaticResource DataValueText}" Margin="0,3"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="全局试次" Style="{StaticResource CaptionText}" Margin="0,3"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FtExpTrialId}" Style="{StaticResource DataValueText}" Margin="0,3"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="当前 v 比例" Style="{StaticResource CaptionText}" Margin="0,3"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FtExpVRatioCurr, StringFormat={}{0:F3}}" Style="{StaticResource DataValueText}" Margin="0,3"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="axis1 目标" Style="{StaticResource CaptionText}" Margin="0,3"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FtExpAxis1Target, StringFormat={}{0:F2} mm}" Style="{StaticResource DataValueText}" Margin="0,3"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="运行状态" Style="{StaticResource CaptionText}" Margin="0,6,0,3"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FtExpActive, StringFormat=active : {0}}" Style="{StaticResource CaptionText}" Margin="0,6,0,3"/>

                            <Border Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                                    x:Name="AbortIndicator"
                                    Background="{StaticResource StatusRedSoftBrush}"
                                    BorderBrush="{StaticResource StatusRedBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,5"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                                <TextBlock Text="实验已中止"
                                           Foreground="{StaticResource StatusRedBrush}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- 绘图操作 -->
                <GroupBox Header="绘图操作" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="2,0">
                        <Button Content="清空曲线" Click="BtnClear_Click"  Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="导出 PNG" Click="BtnExport_Click" Padding="12,6"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 右列：双视图 ============ -->
        <Grid Grid.Column="1" Margin="6,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="F vs t (秒)" Margin="0,0,0,10">
                <scottplot:WpfPlot x:Name="PlotFt"/>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="F vs 从端位移 axis1 (mm)" Margin="0">
                <scottplot:WpfPlot x:Name="PlotFx"/>
            </GroupBox>
        </Grid>
    </Grid>
</Window>
