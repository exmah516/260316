<Window x:Class="AdsControlUI.ForceRealtimeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实时力反馈" Height="460" Width="800"
        MinHeight="340" MinWidth="560"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 图例：药丸 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Style="{StaticResource StatusPill}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="14" Height="3" Fill="{StaticResource SeriesForceBrush}" RadiusX="1.5" RadiusY="1.5"/>
                    <TextBlock Text="F actual (N)" Style="{StaticResource PillLabel}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusPill}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="14" Height="3" Fill="{StaticResource SeriesTorqueBrush}" RadiusX="1.5" RadiusY="1.5"/>
                    <TextBlock Text="T actual (N·m)" Style="{StaticResource PillLabel}" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusPill}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="14" Height="3" Fill="#F87171" RadiusX="1.5" RadiusY="1.5" StrokeDashArray="2 2"/>
                    <TextBlock Text="F theory (N)" Style="{StaticResource PillLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatusPill}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="14" Height="3" Fill="#38BDF8" RadiusX="1.5" RadiusY="1.5" StrokeDashArray="2 2"/>
                    <TextBlock Text="T theory (N·m)" Style="{StaticResource PillLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 绘图画布 -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White" CornerRadius="6">
            <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_SizeChanged">
                <Polyline x:Name="ForceLine"        Stroke="#EF4444" StrokeThickness="2"/>
                <Polyline x:Name="TorqueLine"       Stroke="#0EA5E9" StrokeThickness="2"/>
                <Polyline x:Name="ForceTheoryLine"  Stroke="#F87171" StrokeThickness="2" StrokeDashArray="5 3"/>
                <Polyline x:Name="TorqueTheoryLine" Stroke="#38BDF8" StrokeThickness="2" StrokeDashArray="5 3"/>
                <TextBlock x:Name="YAxisMaxText" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource DataValueText}" FontSize="11"/>
                <TextBlock x:Name="YAxisMinText" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource DataValueText}" FontSize="11"/>
                <TextBlock x:Name="XAxisText" Text="t / s" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource CaptionText}"/>
            </Canvas>
        </Border>

        <!-- 实时读数 -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="14,8">
            <WrapPanel>
                <TextBlock x:Name="ForceValueText"        Style="{StaticResource DataValueText}" Foreground="#EF4444" Margin="0,0,22,0"/>
                <TextBlock x:Name="TorqueValueText"       Style="{StaticResource DataValueText}" Foreground="#0EA5E9" Margin="0,0,22,0"/>
                <TextBlock x:Name="ForceTheoryValueText"  Style="{StaticResource DataValueText}" Foreground="#F87171" Margin="0,0,22,0"/>
                <TextBlock x:Name="TorqueTheoryValueText" Style="{StaticResource DataValueText}" Foreground="#38BDF8"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
