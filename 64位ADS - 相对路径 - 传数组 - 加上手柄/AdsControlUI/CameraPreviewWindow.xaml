<Window x:Class="AdsControlUI.CameraPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OsmoAction4 相机预览" Height="720" Width="1080"
        MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="DeviceStatusText" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="ParameterText" Style="{StaticResource CaptionText}" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="适应画面" Click="Fit_Click" Padding="12,7" VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="1" Background="#101214" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <ScrollViewer x:Name="PreviewScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="PreviewScrollViewer_PreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="PreviewScrollViewer_PreviewMouseLeftButtonUp"
                              PreviewMouseMove="PreviewScrollViewer_PreviewMouseMove"
                              SizeChanged="PreviewScrollViewer_SizeChanged">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                    </Grid>
                </ScrollViewer>
                <Border x:Name="PreviewOverlay" Background="#CC101214" IsHitTestVisible="False">
                    <TextBlock x:Name="PreviewOverlayText" Text="正在打开摄像设备：OsmoAction4"
                               Foreground="White" FontSize="16" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ZoomText" Text="缩放 1.00×" Style="{StaticResource DataValueText}"/>
            <TextBlock Grid.Column="1" x:Name="FrameText" Style="{StaticResource CaptionText}"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" x:Name="RecordingText" Style="{StaticResource DataValueText}" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
