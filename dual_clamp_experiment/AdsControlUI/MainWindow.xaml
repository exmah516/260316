<Window x:Class="DualClampExperimentUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双机构夹持扰动实验" Width="1180" Height="760" MinWidth="980" MinHeight="640"
        Background="#FFFFFF" Foreground="{StaticResource Ink}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="双机构夹持扰动实验" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="轴1 / 轴6 双端对照 · 程序控制" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#F1F5F9" CornerRadius="4" Padding="10,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="PipeIndicator" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PipeStatusText" Text="UI管道: 未连接" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Background="#F1F5F9" CornerRadius="4" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AdsIndicator" Width="10" Height="10" Fill="#EF4444" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AdsStatusText" Text="ADS: 未连接" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource Panel}" Padding="14" CornerRadius="6" Margin="0,0,0,14">
            <WrapPanel>
                <TextBlock Text="器械" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="InstrumentBox" Width="110" SelectedIndex="0" Margin="0,0,16,0">
                    <ComboBoxItem Content="导丝"/>
                    <ComboBoxItem Content="导管"/>
                </ComboBox>
                <TextBlock Text="运动端" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="MovingAxisBox" Width="90" SelectedIndex="0" Margin="0,0,16,0">
                    <ComboBoxItem Content="轴1" Tag="1"/>
                    <ComboBoxItem Content="轴6" Tag="6"/>
                </ComboBox>
                <TextBlock Text="恢复" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="RecoveryBox" Width="120" SelectedIndex="1" Margin="0,0,16,0">
                    <ComboBoxItem Content="夹紧后静止"/>
                    <ComboBoxItem Content="夹紧后输送"/>
                </ComboBox>
                <Button Content="连接/重连" Click="Connect_Click" Padding="16,7" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <Button Content="连接ADS" Click="ConnectAds_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="SelfCheckButton" Content="执行自检" Click="SelfCheck_Click" Padding="14,7" Margin="0,0,8,0"/>
                <Button x:Name="PrepareButton" Content="准备定位" Click="Prepare_Click" Padding="16,7" Margin="0,0,8,0"/>
                <Button x:Name="StartButton" Content="开始实验" Click="Start_Click" Padding="16,7" Margin="0,0,8,0" Background="{StaticResource Accent}" Foreground="White"/>
                <Button Content="中止" Click="Abort_Click" Padding="16,7"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="运动参数" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="轴1距左限位 (mm)" Margin="0,5"/><TextBox x:Name="Axis1Pos" Grid.Row="0" Grid.Column="1" Text="96" Margin="4"/>
                        <TextBlock Grid.Row="1" Text="轴6距左限位 (mm)" Margin="0,5"/><TextBox x:Name="Axis6Pos" Grid.Row="1" Grid.Column="1" Text="580" Margin="4"/>
                        <TextBlock Grid.Row="2" Text="轴2角度 (deg)" Margin="0,5"/><TextBox x:Name="Axis2Angle" Grid.Row="2" Grid.Column="1" Text="0" Margin="4"/>
                        <TextBlock Grid.Row="3" Text="轴7角度 (deg)" Margin="0,5"/><TextBox x:Name="Axis7Angle" Grid.Row="3" Grid.Column="1" Text="0" Margin="4"/>
                        <TextBlock Grid.Row="4" Text="回程距离 (mm)" Margin="0,5"/><TextBox x:Name="ReturnDistance" Grid.Row="4" Grid.Column="1" Text="10" Margin="4"/>
                        <TextBlock Grid.Row="5" Text="回程速度 (mm/s)" Margin="0,5"/><TextBox x:Name="ReturnVelocity" Grid.Row="5" Grid.Column="1" Text="20" Margin="4"/>
                        <TextBlock Grid.Row="6" Text="回程加速度 (mm/s²)" Margin="0,5"/><TextBox x:Name="ReturnAcceleration" Grid.Row="6" Grid.Column="1" Text="100" Margin="4"/>
                        <TextBlock Grid.Row="7" Text="回程减速度 (mm/s²)" Margin="0,5"/><TextBox x:Name="ReturnDeceleration" Grid.Row="7" Grid.Column="1" Text="100" Margin="4"/>
                        <TextBlock Grid.Row="8" Text="回程Jerk (mm/s³)" Margin="0,5"/><TextBox x:Name="ReturnJerk" Grid.Row="8" Grid.Column="1" Text="1000" Margin="4"/>
                    </Grid>
                    <TextBlock Text="当前阶段" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <TextBlock x:Name="PhaseText" Text="Idle" FontSize="22" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="LiveMotionText" Text="轴1 位置/速度/加速度：--\n轴6 位置/速度/加速度：--\n轴2/轴7 周向角度：--" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B42318" Margin="0,8,0,0"/>
                    <Button Content="保存当前试验数据" Click="Save_Click" Padding="12,8" Margin="0,20,0,0"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#D7DEE3" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="实时轴向力通道 (fn1 / fn2 原始值)" FontSize="16" FontWeight="SemiBold"/>
                        <Canvas x:Name="ForceCanvas" Margin="0,30,0,0" Background="#FBFCFD">
                            <Polyline x:Name="Force1Line" Stroke="#0F766E" StrokeThickness="2"/>
                            <Polyline x:Name="Force2Line" Stroke="#C2410C" StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>
                <Border Grid.Row="1" BorderBrush="#D7DEE3" BorderThickness="1" Padding="10">
                    <Grid>
                        <TextBlock Text="实时切向力通道 (ft1 / ft2 原始值)" FontSize="16" FontWeight="SemiBold"/>
                        <Canvas x:Name="TorqueCanvas" Margin="0,30,0,0" Background="#FBFCFD">
                            <Polyline x:Name="Torque1Line" Stroke="#2563EB" StrokeThickness="2"/>
                            <Polyline x:Name="Torque2Line" Stroke="#9333EA" StrokeThickness="2"/>
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
